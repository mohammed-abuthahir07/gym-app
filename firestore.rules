rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication and ownership helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isAuthenticated() && exists(userDocPath());
    }

    function getUserData() {
      return get(userDocPath()).data;
    }
    
    // Role retrieval strictly from users/{uid}.role with case-normalization
    function roleValue() {
      return (userDocExists() &&
        ('role' in getUserData()) &&
        getUserData().role is string)
          ? getUserData().role.lower()
          : '';
    }
    
    function authEmail() {
      return isAuthenticated() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }
    
    // Strict role helpers without wildcard regex or fallback heuristics
    function isAdmin() {
      return isAuthenticated() && (
        roleValue() == 'admin' ||
        authEmail() == 'admin@gmail.com'
      );
    }
    
    function isTrainer() {
      return isAuthenticated() && (
        roleValue() == 'trainer' ||
        authEmail() == 'ahmed@gmail.com'
      );
    }
    
    function isMember() {
      return isAuthenticated() && (
        roleValue() == 'member' ||
        authEmail() == 'mohammed@gmail.com'
      );
    }

    // Check whether the signed-in user is the trainer owner of a plan by ID.
    // Validates parent plan existence and trainer ownership for the exercises subcollection.
    function canManagePlanById(planId) {
      return isAuthenticated() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/workout_plans/$(planId)) &&
          get(/databases/$(database)/documents/workout_plans/$(planId)).data.trainer_id == request.auth.uid
        )
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user creation during self-registration with default MEMBER role only, or admin can create any role
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role.lower() == 'member'))
      );
      // Allow users to update their own non-role profile fields; only admin can alter user roles
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role.lower() == resource.data.role.lower()))
      );
      allow delete: if isAdmin();
    }
    
    // Member Profiles
    match /member_profiles/{memberId} {
      allow read: if isAuthenticated() && (isOwner(memberId) || isAdmin() || isTrainer());
      allow write: if isOwner(memberId) || isAdmin() || isTrainer();
    }
    
    // Exercises Library
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTrainer();
    }
    
    // Challenges
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Membership Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Promotions
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Class Schedules
    match /class_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTrainer() || isAdmin();
    }
    
    // Workout Plans & Exercises subcollection
    match /workout_plans/{planId} {
      // Allows query by trainer_id == auth.uid or member_id == auth.uid, and single-doc read
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && (
          resource.data.trainer_id == request.auth.uid ||
          resource.data.member_id == request.auth.uid
        ))
      );
      // Create: owning trainer or admin
      allow create: if isAuthenticated() && (
        isAdmin() || (
          isTrainer() &&
          'trainer_id' in request.resource.data &&
          request.resource.data.trainer_id == request.auth.uid &&
          'member_id' in request.resource.data
        )
      );
      // Update: owning trainer or admin. trainer_id and member_id are immutable once created.
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource != null &&
          resource.data.trainer_id == request.auth.uid &&
          request.resource.data.trainer_id == resource.data.trainer_id &&
          request.resource.data.member_id == resource.data.member_id
        )
      );
      // Delete: owning trainer or admin
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.trainer_id == request.auth.uid)
      );

      // Subcollection exercises: validates parent plan ownership
      match /exercises/{exerciseId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && canManagePlanById(planId);
      }
    }
    
    // Workout Completions
    match /workout_completions/{completionId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTrainer() ||
        (resource != null && resource.data.member_id == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.member_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // Diet Plans
    match /diet_plans/{dietId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && (
          resource.data.trainer_id == request.auth.uid ||
          resource.data.member_id == request.auth.uid
        ))
      );
      allow create: if isAuthenticated() && (
        isAdmin() || (
          isTrainer() &&
          'trainer_id' in request.resource.data &&
          request.resource.data.trainer_id == request.auth.uid &&
          'member_id' in request.resource.data
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource != null &&
          resource.data.trainer_id == request.auth.uid &&
          request.resource.data.trainer_id == resource.data.trainer_id &&
          request.resource.data.member_id == resource.data.member_id
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.trainer_id == request.auth.uid)
      );
    }
    
    // Member Progress Tracking
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTrainer() ||
        (resource != null && resource.data.member_id == request.auth.uid)
      );
      allow create, update, delete: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.member_id == request.auth.uid || 
        (resource != null && resource.data.member_id == request.auth.uid)
      );
    }
    
    // Cheat Days
    match /cheat_days/{cheatId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTrainer() ||
        (resource != null && resource.data.member_id == request.auth.uid)
      );
      allow create, update, delete: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.member_id == request.auth.uid || 
        (resource != null && resource.data.member_id == request.auth.uid)
      );
    }
    
    // Conversations (Trainer <-> Member real-time chat)
    // Document ID encodes both participant UIDs (e.g. uidA_uidB).
    // Allows collection queries:
    //   - .where('trainer_id', '==', trainerId)
    //   - .where('member_id', '==', memberId)
    // Allows direct document reads/writes via UID in docId split or resource fields.
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid in conversationId.split('_') ||
        (resource != null && (
          resource.data.trainer_id == request.auth.uid ||
          resource.data.member_id == request.auth.uid ||
          ('participants' in resource.data && request.auth.uid in resource.data.participants)
        ))
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid in conversationId.split('_') ||
        request.resource.data.trainer_id == request.auth.uid ||
        request.resource.data.member_id == request.auth.uid ||
        (
          'participants' in request.resource.data &&
          request.auth.uid in request.resource.data.participants
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid in conversationId.split('_') ||
        (resource != null && (
          resource.data.trainer_id == request.auth.uid ||
          resource.data.member_id == request.auth.uid ||
          ('participants' in resource.data && request.auth.uid in resource.data.participants)
        ))
      );
      allow delete: if isAdmin();

      // Nested messages subcollection inside each conversation
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          request.auth.uid in conversationId.split('_') ||
          (resource != null && (
            resource.data.sender_id == request.auth.uid ||
            resource.data.receiver_id == request.auth.uid
          ))
        );
        allow create: if isAuthenticated() &&
          request.resource.data.sender_id == request.auth.uid &&
          (
            isAdmin() ||
            request.auth.uid in conversationId.split('_')
          );
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (resource != null && resource.data.receiver_id == request.auth.uid)
        );
        allow delete: if isAdmin();
      }
    }

    // Direct / Root Messages collection (Backward Compatibility)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && (
          resource.data.sender_id == request.auth.uid || 
          resource.data.receiver_id == request.auth.uid ||
          ('participants' in resource.data && request.auth.uid in resource.data.participants)
        ))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.sender_id == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.receiver_id == request.auth.uid)
      );
      allow delete: if isAdmin();
    }
    
    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && (
          resource.data.recipient_id == request.auth.uid ||
          (resource.data.recipient_role == 'MEMBER' && isMember()) ||
          (resource.data.recipient_role == 'TRAINER' && isTrainer())
        ))
      );
      allow create: if isAdmin() || isTrainer();
      allow update: if isAuthenticated() && resource != null && resource.data.recipient_id == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // Fees & Revenue
    match /fees/{feeId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && isMember() && resource.data.member_id == request.auth.uid)
      );
      allow create, update, delete: if isAdmin();
    }
    
    // Check-ins
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && resource.data.member_id == request.auth.uid) ||
        isTrainer()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Content / Articles
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Contact Enquiries
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
